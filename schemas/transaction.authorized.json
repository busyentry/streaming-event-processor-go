{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "transaction.authorized",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "tenant_id",
    "target_client_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "transaction.authorized"
    },
    "tenant_id": {
      "type": "string"
    },
    "target_client_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "transaction_id",
        "amount",
        "currency"
      ],
      "properties": {
        "transaction_id": {
          "type": "string"
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    }
  }
}
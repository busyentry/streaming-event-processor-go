{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "monitoring.alert",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "tenant_id",
    "target_client_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "monitoring.alert"
    },
    "tenant_id": {
      "type": "string"
    },
    "target_client_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "severity",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}